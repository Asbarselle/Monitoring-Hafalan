APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Audio Analysis Configuration
AUDIO_QUALITY_MIN_BITRATE=128
AUDIO_QUALITY_MIN_DURATION=30
AUDIO_ENABLE_ANALYSIS=true

# Analytics Configuration
ANALYTICS_ENABLE_PREDICTIONS=true
ANALYTICS_ENABLE_RECOMMENDATIONS=true
ANALYTICS_RECALCULATION_INTERVAL=daily

# Firebase Configuration
FIREBASE_ENABLE_STORAGE=true
FIREBASE_PROJECT_ID=simhafal
FIREBASE_DATABASE_URL=https://simhafal.firebaseio.com
FIREBASE_STORAGE_BUCKET=simhafal.appspot.com
FIREBASE_CREDENTIALS_PATH=firebase-service-account.json
FIREBASE_MAX_AUDIO_SIZE=52428800
FIREBASE_ASYNC_UPLOAD=true

VITE_APP_NAME="${APP_NAME}"
